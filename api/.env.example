APP_NAME=Souqa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# `mysql` is the docker-compose service name; use 127.0.0.1 when running bare.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=libyamarket
DB_USERNAME=libyamarket
DB_PASSWORD=secret

# --- Redis (cache + queue broker) ----------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=libyamarket_cache

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@libyamarket.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum --------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# --- Domain configuration -------------------------------------------------
# Flat shipping fee applied per order, and the subtotal above which
# shipping becomes free. Kept in config so pricing is testable & tunable.
SHIPPING_FLAT_RATE=15.00
SHIPPING_FREE_THRESHOLD=500.00
ORDER_CANCELLATION_WINDOW_MINUTES=60
PRODUCT_CACHE_TTL=600

# --- Frontend (CORS allow-list, comma separated) ---------------------------
FRONTEND_URLS=http://localhost:5173
